<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/public/main.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PORTFOLIO</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <div class="frame">
      <div class="main_frame">
        <!-- ===================== LEFT FRAME ===================== -->
        <div class="left_frame">
          <!-- left_1: Profile photo + name + title + social icons -->
          <div class="left_1">
            <div class="left_1-1">
              <img
                src="/images/Profile.png"
                width="156px"
                height="142px"
                style="
                  object-fit: cover;
                  object-position: top center;
                  border-radius: 50%;
                "
                alt="Profile"
              />
            </div>
            <div class="left_1-2"><%=user.name%></div>
            <div class="left_1-3"><%=user.profession%></div>
            <div class="left_icons">
              <a class="link_href" href="#"
                ><div class="icon">
                  <img src="/icons/facebook.svg" alt="facebook" /></div
              ></a>
              <a class="link_href" href="#"
                ><div class="icon">
                  <img src="/icons/instagram.svg" alt="instagram" /></div
              ></a>
              <a class="link_href" href="#"
                ><div class="icon">
                  <img src="/icons/twitter.svg" alt="twitter" /></div
              ></a>
              <a class="link_href" href="#"
                ><div class="icon">
                  <img src="/icons/linkedin.svg" alt="linkedin" /></div
              ></a>
              <a class="link_href" href="#"
                ><div class="icon">
                  <img src="/icons/youtube.svg" alt="youtube" /></div
              ></a>
              <a class="link_href" href="#"
                ><div class="icon">
                  <img src="/icons/globe.svg" alt="website" /></div
              ></a>
            </div>
          </div>

          <div class="marginer"></div>

          <!-- left_2: Info badges (Age, Residence, Freelance, Address) -->
          <div class="left_2">
            <div class="info_row">
              <span class="info_label">Age:</span>
              <span class="info_value"><%=user.age%></span>
            </div>
            <div class="info_row">
              <span class="info_label">Residence:</span>
              <span class="info_value"><%=user.residence%></span>
            </div>
            <div class="info_row">
              <span class="info_label">Freelance:</span>
              <span class="info_value available"><%=user.freelance%></span>
            </div>
            <div class="info_row">
              <span class="info_label">Address:</span>
              <span class="info_value"><%=user.address%></span>
            </div>
          </div>

          <div class="marginer"></div>

          <!-- left_3: Languages -->
          <div class="left_3">
            <div class="skill_section_title">Languages</div>
            <% user.languages.forEach(function(lang){ %>
            <div class="skill_item">
              <div class="skill_header">
                <span><%=lang.name%></span><span><%=lang.level%>%</span>
              </div>
              <div class="skill_bar">
                <div class="skill_fill" style="width: <%=lang.level%>%"></div>
              </div>
            </div>
            <% }) %>
          </div>

          <div class="marginer"></div>

          <!-- left_4: Skills -->
          <div class="left_4">
            <div class="skill_section_title">Skills</div>
            <% user.skills.forEach(function(skill){ %>
            <div class="skill_item">
              <div class="skill_header">
                <span><%=skill.name%></span><span><%=skill.level%>%</span>
              </div>
              <div class="skill_bar">
                <div class="skill_fill" style="width: <%=skill.level%>%"></div>
              </div>
            </div>
            <% }) %>
          </div>

          <div class="marginer"></div>

          <!-- left_5: Extra Skills -->
          <div class="left_5">
            <div class="skill_section_title">Extra Skills</div>
            <ul class="extra_skills_list">
              <% user.extraSkills.forEach(function(skill){ %>
              <li><span class="dot"></span> <%=skill%></li>
              <% }) %>
            </ul>
          </div>

          <div class="marginer"></div>

          <!-- Download CV Button -->
          <div class="download_wrap">
            <a href="#" class="download_btn">
              DOWNLOAD CV
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
            </a>
          </div>
        </div>
        <!-- end left_frame -->

        <!-- ===================== MIDDLE FRAME ===================== -->
        <div class="midd_frame">
          <!-- HERO SECTION -->
          <div class="hero_section">
            <div class="hero_text">
              <h1>Doctor neurologists<br />in OHSU Hospital</h1>
              <p>
                Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit. Et,
                Volutpat Feugiat Placerat Lobortis. Natoque Rutrum Semper Sed
                Suspendisse Nunc Lectus.
              </p>
              <a href="#" class="hire_btn">
                HIRE ME
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            </div>
            <div class="hero_image">
              <!-- Decorative shapes -->
              <div
                class="deco deco_circle_green"
                style="top: 14px; left: 10px"
              ></div>
              <div
                class="deco deco_square_blue"
                style="top: 70px; right: 20px"
              ></div>
              <div
                class="deco deco_circle_fill"
                style="bottom: 30px; left: 14px"
              ></div>
              <div
                class="deco deco_triangle"
                style="bottom: 40px; right: 18px"
              ></div>
              <div
                class="deco deco_circle_yellow"
                style="top: 50%; right: 50px"
              ></div>
              <div
                class="deco deco_square_sm"
                style="top: 20px; left: 40%"
              ></div>
              <img src="/images/Profile.png" alt="Marcos" class="hero_img" />
              <div class="hero_corner_badge"></div>
            </div>
          </div>

          <!-- SERVICES SECTION -->
          <div class="services_section">
            <div class="services_header">
              <h2>My Services</h2>
              <p>
                Amet Minim Mollit Non Deserunt Ullamco Est Sit Aliqua Dolor<br />
                Do Amet Sint. Velit Officia Consequat Duis Enim Velit Mollit.<br />
                Lorem Ipsum
              </p>
            </div>

            <div class="row g-3">
              <!-- Web Development -->
              <div class="col-4">
                <div class="service_card">
                  <div class="service_icon">
                    <img src="/icons/web-dev.svg" alt="Web Development" />
                  </div>
                  <h3>Web Development</h3>
                  <p>Blog, E-Commerce</p>
                </div>
              </div>

              <!-- UI/UX Design -->
              <div class="col-4">
                <div class="service_card">
                  <div class="service_icon">
                    <img src="/icons/uiux.svg" alt="UI/UX Design" />
                  </div>
                  <h3>UI/UX Design</h3>
                  <p>Mobile App, Website Design</p>
                </div>
              </div>

              <!-- Sound Design -->
              <div class="col-4">
                <div class="service_card">
                  <div class="service_icon">
                    <img src="/icons/sound.svg" alt="Sound Design" />
                  </div>
                  <h3>Sound Design</h3>
                  <p>Voice Over, Beat Making</p>
                </div>
              </div>

              <!-- Game Design -->
              <div class="col-4">
                <div class="service_card">
                  <div class="service_icon">
                    <img src="/icons/game.svg" alt="Game Design" />
                  </div>
                  <h3>Game Design</h3>
                  <p>Character Design, Props & Objects</p>
                </div>
              </div>

              <!-- Photography -->
              <div class="col-4">
                <div class="service_card">
                  <div class="service_icon">
                    <img src="/icons/photo.svg" alt="Photography" />
                  </div>
                  <h3>Photography</h3>
                  <p>Portrait, Product Photography</p>
                </div>
              </div>

              <!-- Advertising -->
              <div class="col-4">
                <div class="service_card service_card_advertising">
                  <h3>Advertising</h3>
                  <p>
                    Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit.
                    Vitae Nulla Diam In Ac Dictum A Urna Viverra Morbi.
                  </p>
                  <a href="#" class="order_now_btn"> ORDER NOW &rarr; </a>
                </div>
              </div>
            </div>
            <!-- end row -->
          </div>
          <!-- end services_section -->
        </div>
        <!-- end midd_frame -->

        <!-- ===================== RIGHT FRAME ===================== -->
        <div class="right_frame">
          <div class="right_nav_label">Home</div>
          <a href="#" class="right_nav_icon active" title="Home">
            <img src="/icons/nav-home.svg" alt="Home" />
          </a>
          <a href="#" class="right_nav_icon" title="Resume">
            <img src="/icons/nav-resume.svg" alt="Resume" />
          </a>
          <a href="#" class="right_nav_icon" title="About">
            <img src="/icons/nav-about.svg" alt="About" />
          </a>
          <a href="#" class="right_nav_icon" title="Portfolio">
            <img src="/icons/nav-portfolio.svg" alt="Portfolio" />
          </a>
          <a href="#" class="right_nav_icon" title="Services">
            <img src="/icons/nav-services.svg" alt="Services" />
          </a>
          <a href="#" class="right_nav_icon" title="Contact">
            <img src="/icons/nav-contact.svg" alt="Contact" />
          </a>
        </div>
        <!-- end right_frame -->
      </div>
      <!-- end main_frame -->
    </div>
    <!-- end frame -->
  </body>
</html>
